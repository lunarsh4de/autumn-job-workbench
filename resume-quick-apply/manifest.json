{
  "manifest_version": 3,
  "name": "投简历助手",
  "version": "0.15.0",
  "description": "从简历分类多类经历，在招聘网站快速填充，并在本地秋招工作台管理岗位进度。",
  "homepage_url": "https://github.com/lunarsh4de",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "contextMenus"],
  "action": {
    "default_title": "投简历助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "quick-fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "快速填充当前页面"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
