# Keep source files consistent across Windows worktrees.
* text=auto
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.svg text eol=lf

# Generated documents and archives are binary.
*.docx binary
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
